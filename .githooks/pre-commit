#!/bin/sh
# Format staged R files with air and re-stage them, then lint them.

# Collect staged .R files that are added/modified (not deleted)
staged=$(git diff --cached --name-only --diff-filter=ACM | grep '\.R$')

if [ -z "$staged" ]; then
  exit 0
fi

if command -v air >/dev/null 2>&1; then
  # Format each file and re-stage
  for file in $staged; do
    air format "$file"
    git add "$file"
  done
  echo "air: formatted staged R files and re-staged." >&2
else
  echo "WARNING: air not found — skipping R format check." >&2
  echo "Install air 0.13.0: brew install air (macOS), or see https://posit-dev.github.io/air/" >&2
fi

# Lint: staged files must have zero lints (rules in .lintr).
if command -v Rscript >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  if ! Rscript tools/lint.R $staged >&2; then
    echo "" >&2
    echo "COMMIT BLOCKED: lints found (see above). Fix them or see .lintr." >&2
    exit 1
  fi
else
  echo "WARNING: Rscript not found — skipping lint." >&2
fi

# Undefined-name check over the project functions (codetools; see
# tools/check_globals.R). Runs on the whole project, not just staged files,
# because a change in one R/ file can break a function in another.
if command -v Rscript >/dev/null 2>&1; then
  if ! Rscript tools/check_globals.R >&2; then
    echo "" >&2
    echo "COMMIT BLOCKED: undefined names found (see above)." >&2
    exit 1
  fi
else
  echo "WARNING: Rscript not found — skipping undefined-name check." >&2
fi

exit 0
