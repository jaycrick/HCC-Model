#!/bin/sh
# Allowed prefixes: :zap: :bug: :tv: :cop: :abc:
msg=$(cat "$1")

case "$msg" in
  Merge*|fixup!*|squash!*) exit 0 ;;
  :zap:*|:bug:*|:tv:*|:cop:*|:abc:*) exit 0 ;;
esac

echo "COMMIT REJECTED: message must start with one of:" >&2
echo "  :zap:  features / behaviour changes" >&2
echo "  :bug:  bug fixes" >&2
echo "  :tv:   CI, tooling, configuration" >&2
echo "  :cop:  tests and linting" >&2
echo "  :abc:  documentation" >&2
exit 1
